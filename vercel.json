{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/offline",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/smart-pass",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/phong-nghi",
      "destination": "/rooms",
      "permanent": true
    },
    {
      "source": "/dat-phong",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/lien-he",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/:legacy(blog-detail|blog-detail\\.html)",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "bi-quyet-thue-phong-theo-gio"
        }
      ],
      "destination": "/blog/thue-phong-theo-gio-duong-dong",
      "permanent": true
    },
    {
      "source": "/:legacy(blog-detail|blog-detail\\.html)",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "top-5-quan-hai-san-dem"
        }
      ],
      "destination": "/blog/an-hai-san-buoi-toi-duong-dong",
      "permanent": true
    },
    {
      "source": "/:legacy(blog-detail|blog-detail\\.html)",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "lich-trinh-phuot-phu-quoc-3n2d"
        }
      ],
