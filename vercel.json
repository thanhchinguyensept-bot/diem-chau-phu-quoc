{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/phong-nghi",
      "status": 308,
      "headers": { "Location": "/rooms" }
    },
    {
      "src": "/dat-phong",
      "status": 308,
      "headers": { "Location": "/booking" }
    },
    {
      "src": "/smart-pass",
      "dest": "/smart-pass.html"
    },
    {
      "src": "/blog",
      "dest": "/blog.html"
    },
    {
      "src": "/lien-he",
      "status": 308,
      "headers": { "Location": "/contact" }
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/prototype",
      "dest": "/prototype.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
