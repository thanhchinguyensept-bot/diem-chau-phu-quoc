    },
    {
      "source": "/:legacy(blog-detail|blog-detail\\.html)",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "tai-sao-mo-hinh-tu-dong-hoa-smart-lock"
        }
      ],
      "destination": "/blog/nhan-phong-tai-diem-chau",
      "permanent": true
    },
    {
      "source": "/:legacy(blog-detail|blog-detail\\.html)",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "checklist-hanh-ly-phu-quoc"
        }
      ],
      "destination": "/blog/checklist-hanh-ly-phu-quoc",
      "permanent": true
    },
    {
      "source": "/:legacy(blog-detail|blog-detail\\.html)",
